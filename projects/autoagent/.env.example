# AutoAgent — provider config (Qubax, OpenAI-compatible).
# Copy to .env and fill OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.qubax.ai/v1
API_BASE_URL=https://api.qubax.ai/v1

# Main model (framework uses COMPLETION_MODEL for all agents).
COMPLETION_MODEL=qwen3-235b-a22b-2507
EMBEDDING_MODEL=text-embedding-3-small
FN_CALL=True

# Per-phase models (auto_zen.py multi-model orchestration).
TRIAGE_MODEL=qwen3-32b
PLANNER_MODEL=qwen3-235b-a22b-2507
CODER_MODEL=glm-5.2
REPORTER_MODEL=glm-4.7-flash
