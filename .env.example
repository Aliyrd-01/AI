# ── Qdrant Cloud ( rag_v2_q_test ) ───────────────────────────────────────────
QDRANT_URL=https://<cluster>.europe-west3-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_v2_q_test

# ── FastEmbed ───────────────────────────────────────────────────────────────
# dense-модель обязана совпадать с той, по которой построен индекс (768d)
FASTEMBED_DENSE_MODEL=nomic-ai/nomic-embed-text-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25
FASTEMBED_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
FASTEMBED_CACHE_PATH=/data/fastembed

# ── LLM Providers ───────────────────────────────────────────────────────────
# Qubax (primary): OpenAI-совместимый, оплата криптой, от $3, без карты
QUBAX_API_KEY=
QUBAX_API_BASE=https://api.qubax.ai/v1
QUBAX_MODELS=qwen3-235b-a22b-2507,minimax-m2.5

# Google Gemini API
GEMINI_API_KEY=
GOOGLE_API_KEY=

# xAI Grok API
XAI_API_KEY=

# Mistral API
MISTRAL_API_KEY=

# Судья для eval: НЕ должен совпадать с отвечающей моделью (иначе self-bias).
JUDGE_MODEL=qwen3-32b

# Zen (OpenCode)
OPENAI_API_BASE=https://opencode.ai/zen/v1
OPENAI_API_KEY=
ZEN_MODEL=big-pickle

# OpenRouter free — последний резерв
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ALLOW_OPENROUTER=1

# ── Tracing & Cache ─────────────────────────────────────────────────────────
# LangSmith — используется (проект production-rag), пишет трэйсы всех вызовов.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_PROJECT=production-rag

# Langfuse — выключен по умолчанию (только FastAPI-вариант, module_12_api).
ENABLE_LANGFUSE=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Semantic cache for the FastAPI variant (module_12_api):
CACHE_ENABLED=1
CACHE_TTL=3600
CACHE_SIM_THRESHOLD=0.92
CACHE_MAX=256

# ── Unified Agent & MCP ─────────────────────────────────────────────────────
MCP_URL=http://localhost:9002/mcp
MCP_TOKEN=
AGENT_MODEL=qwen3-235b-a22b-2507
UA_PRICE_IN=0
UA_PRICE_OUT=0

# ── AutoAgent Framework ─────────────────────────────────────────────────────
GITHUB_AI_TOKEN=
COMPLETION_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_MODEL=text-embedding-3-small

# ── Telegram LightRAG Bot ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
LIGHTRAG_URL=http://localhost:9621/query

# ── Optional RAG MySQL Storage ──────────────────────────────────────────────
RAG_MYSQL_HOST=
RAG_MYSQL_PORT=3306
RAG_MYSQL_USER=
RAG_MYSQL_PASS=
RAG_MYSQL_DB=
