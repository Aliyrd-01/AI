      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        200
      ],
      "parameters": {
        "jsCode": "const msg = $input.item.json.message;\nconst replyTo = msg.reply_to_message;\n\nif (!replyTo || !replyTo.text) {\n  return [{json: { user_chat_id: \"\", is_close: \"no\", reply_text: \"\" }}];\n}\n\nconst match = replyTo.text.match(/\\(ID: (\\d+)\\)/);\n\nreturn [{json: {\n  user_chat_id: match ? match[1] : \"\",\n  is_close: msg.text.trim() === \"/close\" ? \"yes\" : \"no\",\n  reply_text: msg.text\n}}];"
      }
    },
