# Reverse proxy + automatic HTTPS for the VPS deploy (phase 6).
# Replace the domain below, then run Caddy in front of the hub container.

your-domain.example {
    encode gzip
    # If running Caddy on the VPS host (recommended in DEPLOY.md):
    reverse_proxy 127.0.0.1:7860
    # If running Caddy inside the same Docker network as hub:
    # reverse_proxy hub:7860
}
